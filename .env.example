# Copy this file to .env and fill in the key. .env is gitignored -- never commit it.
#
#   cp .env.example .env
#   python scripts/smoke_llm.py

GEMINI_API_KEY=

# Optional. Defaults are gemini-3.6-flash for both. Set these to whatever the
# smoke test actually proves works against your key.
# PLANNER_MODEL=gemini-3.6-flash
# REVIEWER_MODEL=gemini-3.6-flash

# Optional. Defaults to in-memory; set a path for a store that survives restart.
# DESK_DB=desk.sqlite

# Browser origins allowed to call the API. Comma-separated.
# Unset  -> local dev servers only (Vite 5173, Next 3000).
# 'none' -> no CORS headers at all; use this when the frontend is served from
#           the same origin, which is the case for a single container.
# ALLOWED_ORIGINS=https://your-user-your-space.hf.space
