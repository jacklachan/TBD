# Copy this file to .env and fill in the key. .env is gitignored -- never commit it.
#
#   cp .env.example .env
#   python scripts/smoke_llm.py

HF_TOKEN=

# Required for remote API access. Use a long random value. The frontend asks
# the operator for it and sends it as a bearer token, never in a URL.
# Local loopback development works without this setting.
DESK_ACCESS_TOKEN=

# Sign-in shown when DESK_ACCESS_TOKEN is set, so nobody has to type the token.
# A shared demo login, not authentication -- see backend/operators.py.
# DESK_ADMIN_USER=Paan
# DESK_ADMIN_PASSWORD=Banaras

# Use a persistent fine-grained HF token with Make calls to Inference Providers.
# A temporary CLI OAuth token is unsuitable as a permanent Space secret.
# GEMINI_API_KEY is no longer used by the runtime.
# PLANNER_MODEL=zai-org/GLM-5.3-Flash:baseten
# REVIEWER_MODEL=zai-org/GLM-5.3-Flash:baseten
# HF_BASE_URL=https://router.huggingface.co/v1
# A dedicated HF endpoint may instead supply its HTTPS /v1 base and model ID.

# Optional. Defaults to in-memory; set a path for a store that survives restart.
# DESK_DB=desk.sqlite

# Browser origins allowed to call the API. Comma-separated.
# Unset  -> local dev servers only (Vite 5173, Next 3000).
# 'none' -> no CORS headers at all; use this when the frontend is served from
#           the same origin, which is the case for a single container.
# ALLOWED_ORIGINS=https://your-user-your-space.hf.space
